{
  "name": "watchvault",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Watch-only Ethereum wallet monitor with per-wallet expected amounts and drift alerts",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test:relay": "node scripts/test-relay.mjs",
    "test:transport": "node scripts/test-transport.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^31.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
